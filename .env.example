# Every credential a release needs, as environment variables.
#
# Copy to `.env` (gitignored) and fill it in, or set the same names as
# GitHub Actions secrets (Settings > Secrets and variables > Actions). Then:
#
#   dart run tool/release_env.dart --release
#   flutter build appbundle --release --dart-define-from-file=config/app_config.json
#
# or run the "release" workflow on GitHub, which does both. docs/RELEASE.md
# says where each value comes from.

# Google Drive backup (M20). Google Cloud Console > Credentials > OAuth
# client ID > Android, package pk.bazaarledger, SHA-1 from Play Console >
# App integrity > App signing key certificate.
GOOGLE_OAUTH_CLIENT_ID=

# Subscriptions (M21). Play Console > Monetise > Monetisation setup >
# Licensing: the base64 public key.
PLAY_BILLING_PUBLIC_KEY=

# The upload key. Either the keystore as base64 (`base64 -w0 upload.jks`)...
UPLOAD_KEYSTORE_BASE64=
# ...or, on a laptop, the path to it.
UPLOAD_KEYSTORE_PATH=
UPLOAD_STORE_PASSWORD=
UPLOAD_KEY_ALIAS=upload
UPLOAD_KEY_PASSWORD=

# Optional, CI only: a Play Console service account's JSON key, so the
# release workflow uploads the bundle to the internal testing track itself.
PLAY_SERVICE_ACCOUNT_JSON=
