<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      INTERNET is here now, and the reason is worth stating precisely because
      the claim it changes is one a shopkeeper can check for themselves.

      Until M2 this manifest had no INTERNET permission at all, and the comment
      here said the app "cannot phone anywhere". That was true and it was a
      good thing to be able to point at. It stopped being possible the moment
      the LAN printer transport landed: Android gates the creation of ANY
      socket behind INTERNET, including a socket to a printer on the shop's own
      Wi-Fi with a 192.168 address. There is no narrower permission for a local
      connection — `ACCESS_LOCAL_NETWORK` arrives at targetSdk 37, roughly
      2027, and it is additional to this rather than instead of it.

      So the honest version of the claim, which is what the app should say: no
      byte of a shopkeeper's books is sent to any server we operate, because we
      operate none. The billing path makes no network call whatsoever. What
      this permission buys is a printer on the shop's own network, and later a
      backup the owner explicitly turns on, to their own Drive.

      A release build that quietly could not open a socket would have been
      worse than either: the LAN printer would simply have failed on a real
      phone, having passed every test, because the tests run on a host where
      Android's permission model does not exist.

      Everything else still arrives with the milestone that earns it. Camera
      with barcode scanning, USB host with the USB printer, and nothing
      speculative — declaring a permission with no feature behind it makes the
      Play Data Safety form a lie.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Bazaar Ledger"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <!--
          allowBackup is off deliberately. The books are the shop's books and
          must not be swept into a Google account backup the owner never asked
          for. Backup is a feature this app provides explicitly in M5, with a
          recovery phrase the owner holds, not a silent copy on someone
          else's server.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!--
      Narrow <queries> rather than QUERY_ALL_PACKAGES, which Play treats as a
      sensitive permission needing a declared exception. Sharing a receipt PDF
      goes through the system share sheet, which needs no query at all; this
      entry exists so a future "send to WhatsApp" button can tell whether
      WhatsApp is installed before offering itself.
    -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="application/pdf" />
        </intent>
    </queries>
</manifest>
