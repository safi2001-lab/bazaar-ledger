import 'core.drift';
import 'catalogue.drift';
import 'ledger.drift';

-- Bazaar Ledger — schema v6: making things (M17).
--
-- A bill of materials says what one batch of a finished item is made of: so
-- many grams of each spice for so many packs of masala, and what the work
-- and the packets cost on top. An assembly is one production run of it: the
-- components leave the shelf and the finished goods arrive, in the stock
-- ledger as assembly_out and assembly_in, which it has allowed since v1.

CREATE TABLE boms (
  id TEXT NOT NULL PRIMARY KEY,
  firm_id TEXT NOT NULL REFERENCES firms(id) DEFERRABLE INITIALLY DEFERRED,
  created_at_utc INTEGER NOT NULL,
  updated_at_utc INTEGER NOT NULL,
  created_by TEXT NOT NULL REFERENCES users(id) DEFERRABLE INITIALLY DEFERRED,
  updated_by TEXT NOT NULL REFERENCES users(id) DEFERRABLE INITIALLY DEFERRED,
  deleted_at_utc INTEGER,
  origin_device_id TEXT NOT NULL REFERENCES devices(id) DEFERRABLE INITIALLY DEFERRED,
  hlc TEXT NOT NULL,
  rev INTEGER NOT NULL DEFAULT 1,

  name TEXT NOT NULL,
  output_item_id TEXT NOT NULL REFERENCES items(id) DEFERRABLE INITIALLY DEFERRED,
  -- How much one batch makes, in the output's base unit, thousandths.
  output_qty_thousandths INTEGER NOT NULL CHECK (output_qty_thousandths > 0),
  -- Work, packets, gas: what a batch costs beyond its components.
  overhead_paisa INTEGER NOT NULL DEFAULT 0 CHECK (overhead_paisa >= 0)
) STRICT;

CREATE INDEX idx_boms_firm ON boms (firm_id, name);
CREATE INDEX idx_boms_output ON boms (output_item_id);

CREATE TABLE bom_lines (
  id TEXT NOT NULL PRIMARY KEY,
  firm_id TEXT NOT NULL REFERENCES firms(id) DEFERRABLE INITIALLY DEFERRED,
  created_at_utc INTEGER NOT NULL,
  updated_at_utc INTEGER NOT NULL,
  created_by TEXT NOT NULL REFERENCES users(id) DEFERRABLE INITIALLY DEFERRED,
  updated_by TEXT NOT NULL REFERENCES users(id) DEFERRABLE INITIALLY DEFERRED,
  deleted_at_utc INTEGER,
  origin_device_id TEXT NOT NULL REFERENCES devices(id) DEFERRABLE INITIALLY DEFERRED,
  hlc TEXT NOT NULL,
  rev INTEGER NOT NULL DEFAULT 1,

  bom_id TEXT NOT NULL REFERENCES boms(id) DEFERRABLE INITIALLY DEFERRED,
  line_no INTEGER NOT NULL CHECK (line_no > 0),
  component_item_id TEXT NOT NULL REFERENCES items(id) DEFERRABLE INITIALLY DEFERRED,
  -- Per batch, in the component's base unit, thousandths.
  qty_thousandths INTEGER NOT NULL CHECK (qty_thousandths > 0)
) STRICT;

CREATE INDEX idx_bomlines_firm ON bom_lines (firm_id, bom_id);
CREATE INDEX idx_bomlines_bom ON bom_lines (bom_id, line_no);
CREATE INDEX idx_bomlines_item ON bom_lines (component_item_id);

CREATE TABLE assemblies (
  id TEXT NOT NULL PRIMARY KEY,
  firm_id TEXT NOT NULL REFERENCES firms(id) DEFERRABLE INITIALLY DEFERRED,
  created_at_utc INTEGER NOT NULL,
  updated_at_utc INTEGER NOT NULL,
  created_by TEXT NOT NULL REFERENCES users(id) DEFERRABLE INITIALLY DEFERRED,
  updated_by TEXT NOT NULL REFERENCES users(id) DEFERRABLE INITIALLY DEFERRED,
  deleted_at_utc INTEGER,
  origin_device_id TEXT NOT NULL REFERENCES devices(id) DEFERRABLE INITIALLY DEFERRED,
  hlc TEXT NOT NULL,
  rev INTEGER NOT NULL DEFAULT 1,

  bom_id TEXT NOT NULL REFERENCES boms(id) DEFERRABLE INITIALLY DEFERRED,
  assembly_no TEXT NOT NULL,
  runs INTEGER NOT NULL CHECK (runs > 0),
  output_item_id TEXT NOT NULL REFERENCES items(id) DEFERRABLE INITIALLY DEFERRED,
  output_qty_thousandths INTEGER NOT NULL CHECK (output_qty_thousandths > 0),
  components_cost_paisa INTEGER NOT NULL CHECK (components_cost_paisa >= 0),
  overhead_paisa INTEGER NOT NULL CHECK (overhead_paisa >= 0),
  journal_entry_id TEXT REFERENCES journal_entries(id) DEFERRABLE INITIALLY DEFERRED,
  made_on_local TEXT NOT NULL
) STRICT;

CREATE UNIQUE INDEX idx_assemblies_no ON assemblies (firm_id, assembly_no);
CREATE INDEX idx_assemblies_bom ON assemblies (bom_id);
CREATE INDEX idx_assemblies_output ON assemblies (output_item_id);
CREATE INDEX idx_assemblies_journal ON assemblies (journal_entry_id);
