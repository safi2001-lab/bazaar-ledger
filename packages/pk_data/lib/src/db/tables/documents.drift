import 'core.drift';
import 'catalogue.drift';
import 'stock.drift';
import 'system.drift';

-- Bazaar Ledger — schema v1, part 3 of 7: the polymorphic document.
--
-- Nine document types share about 90% of their columns and every one of them
-- converts into another: estimate becomes challan becomes invoice. Modelling
-- them as nine tables would mean nine of every query, nine report paths, and a
-- conversion that re-keys data. One table, one doc_type, one set of indexes.
--
-- A posted document is IMMUTABLE. An edit is revision N+1 plus a reversing
-- journal entry; a delete is a void plus a reversal. Nothing is ever silently
-- rewritten under a shopkeeper who already printed and handed over the paper.

CREATE TABLE documents (
  id TEXT NOT NULL PRIMARY KEY,
  firm_id TEXT NOT NULL REFERENCES firms(id) DEFERRABLE INITIALLY DEFERRED,
  created_at_utc INTEGER NOT NULL,
  updated_at_utc INTEGER NOT NULL,
  created_by TEXT NOT NULL REFERENCES users(id) DEFERRABLE INITIALLY DEFERRED,
  updated_by TEXT NOT NULL REFERENCES users(id) DEFERRABLE INITIALLY DEFERRED,
  deleted_at_utc INTEGER,
  origin_device_id TEXT NOT NULL REFERENCES devices(id) DEFERRABLE INITIALLY DEFERRED,
  hlc TEXT NOT NULL,
  rev INTEGER NOT NULL DEFAULT 1,

  doc_type TEXT NOT NULL CHECK (doc_type IN (
    'sale_invoice', 'sale_return', 'purchase_bill', 'purchase_return',
    'quotation', 'proforma', 'delivery_challan', 'sale_order',
    'purchase_order', 'expense', 'other_income')),
  doc_no TEXT NOT NULL,
  doc_series TEXT NOT NULL,
  doc_seq INTEGER NOT NULL,
  fiscal_year INTEGER NOT NULL,

  doc_date_utc INTEGER NOT NULL,
  -- 'YYYY-MM-DD' in Pakistan Standard Time. Every date-bucketed report groups
  -- on this, never on an epoch converted at query time: PKT is UTC+5 with no
  -- daylight saving, so a UTC-based day boundary puts the last five hours of
  -- every business day into tomorrow's Day Book.
  doc_date_local TEXT NOT NULL,

  party_id TEXT REFERENCES parties(id) DEFERRABLE INITIALLY DEFERRED,
  -- Snapshots. A walk-in has no party row at all, and a party who later
  -- changes their name must not change what an old invoice says.
  party_name_snapshot TEXT,
  party_ntn_snapshot TEXT,
  party_strn_snapshot TEXT,
  party_address_snapshot TEXT,

  status TEXT NOT NULL DEFAULT 'draft'
    CHECK (status IN ('draft', 'posted', 'void')),
  revision INTEGER NOT NULL DEFAULT 1 CHECK (revision >= 1),
  supersedes_id TEXT REFERENCES documents(id) DEFERRABLE INITIALLY DEFERRED,
  voided_by_id TEXT REFERENCES documents(id) DEFERRABLE INITIALLY DEFERRED,
  void_reason TEXT,

  -- All amounts are whole paisa. Every one of them is derived from the lines
  -- and re-asserted before commit; they are stored so a list of 20,000
  -- invoices does not have to re-aggregate to draw one screen.
  subtotal_paisa INTEGER NOT NULL DEFAULT 0,
  line_discount_paisa INTEGER NOT NULL DEFAULT 0,
  bill_discount_paisa INTEGER NOT NULL DEFAULT 0,
  taxable_paisa INTEGER NOT NULL DEFAULT 0,
  tax_paisa INTEGER NOT NULL DEFAULT 0,
  further_tax_paisa INTEGER NOT NULL DEFAULT 0,
  withholding_paisa INTEGER NOT NULL DEFAULT 0,
  extra_charges_paisa INTEGER NOT NULL DEFAULT 0,
  -- Posted to its own account, never quietly absorbed into the total.
  round_off_paisa INTEGER NOT NULL DEFAULT 0,
  total_paisa INTEGER NOT NULL DEFAULT 0,
  paid_paisa INTEGER NOT NULL DEFAULT 0,
  balance_paisa INTEGER NOT NULL DEFAULT 0,
  cost_paisa INTEGER NOT NULL DEFAULT 0,

  prices_include_tax INTEGER NOT NULL DEFAULT 0
    CHECK (prices_include_tax IN (0, 1)),
  -- Stamped from the firm at post time. Reprints must round the way they
  -- rounded on the day.
  rounding_mode TEXT NOT NULL DEFAULT 'half_up'
    CHECK (rounding_mode IN ('half_up', 'half_even', 'truncate', 'ceil_abs')),
  -- Which effective-dated tax pack computed this document. Tax rules change
  -- every July; an invoice from last year must reprint at last year's rates.
  tax_rule_version TEXT NOT NULL DEFAULT 'v0',

  place_of_supply TEXT,
  sale_type TEXT,
  salesperson_id TEXT REFERENCES users(id) DEFERRABLE INITIALLY DEFERRED,

  -- Non-fiscal fields. These stay editable forever, on a posted document, by
  -- design: a bilty number arrives after the invoice is printed.
  notes TEXT,
  terms TEXT,
  vehicle_no TEXT,
  bilty_no TEXT,
  transporter TEXT,
  ship_to TEXT,
  -- The number on the supplier's own paper, on a purchase bill. Added in v3:
  -- the purchase screen had asked for it since M4 and it was written only
  -- into an audit sentence, so the one number a supplier quotes when they
  -- ring about an unpaid delivery could not be found or shown anywhere.
  supplier_bill_no TEXT,

  -- s.21(s), Finance Act 2025: 50% of the expenditure is disallowed where a
  -- single invoice above Rs 200,000 is settled otherwise than through a
  -- banking or digital channel. Set at post time so the report never has to
  -- re-derive intent from payment rows.
  cash_threshold_breached INTEGER NOT NULL DEFAULT 0
    CHECK (cash_threshold_breached IN (0, 1)),

  posted_at_utc INTEGER,

  -- Where the goods on a sale left from (M18): NULL for the shop floor, or
  -- a van's location code. A rider's cash is counted against exactly the
  -- sales that left from their van.
  location_code TEXT,

  -- FBR Digital Invoicing (M19). NULL on every bill of a shop that does
  -- not report to FBR, and on every bill made before it started to.
  -- 'pending' until FBR has answered; 'posted' with FBR's own number, or
  -- 'rejected' with its reason in words.
  fbr_status TEXT
    CHECK (fbr_status IS NULL OR fbr_status IN ('pending', 'posted', 'rejected')),
  fbr_invoice_no TEXT,
  fbr_error TEXT,
  fbr_posted_at_utc INTEGER,

  CHECK (revision = 1 OR supersedes_id IS NOT NULL),
  -- An unpaid balance is somebody's khata. The counter refuses an
  -- anonymous debtor, but a UI rule protects only the UI: an import, a
  -- repair script, or an M13 LAN merge could each commit money the shop
  -- can never ask for, sitting in a receivables total that still balances.
  CHECK (balance_paisa <= 0 OR party_id IS NOT NULL),
  CHECK (status <> 'posted' OR posted_at_utc IS NOT NULL)
) STRICT;

CREATE UNIQUE INDEX idx_documents_no
  ON documents (firm_id, doc_type, doc_no, revision);
CREATE INDEX idx_documents_list
  ON documents (firm_id, doc_type, doc_date_local, id);
CREATE INDEX idx_documents_party
  ON documents (party_id, doc_date_local);
CREATE INDEX idx_documents_status
  ON documents (firm_id, status, doc_date_local);
CREATE INDEX idx_documents_open_balance
  ON documents (firm_id, party_id, doc_date_local) WHERE balance_paisa <> 0;
CREATE INDEX idx_documents_supersedes ON documents (supersedes_id);
CREATE INDEX idx_documents_voided_by ON documents (voided_by_id);
CREATE INDEX idx_documents_salesperson ON documents (salesperson_id);
CREATE INDEX idx_documents_fbr ON documents (firm_id, fbr_status)
  WHERE fbr_status IS NOT NULL;

CREATE TABLE document_lines (
  id TEXT NOT NULL PRIMARY KEY,
  firm_id TEXT NOT NULL REFERENCES firms(id) DEFERRABLE INITIALLY DEFERRED,
  created_at_utc INTEGER NOT NULL,
  updated_at_utc INTEGER NOT NULL,
  created_by TEXT NOT NULL REFERENCES users(id) DEFERRABLE INITIALLY DEFERRED,
  updated_by TEXT NOT NULL REFERENCES users(id) DEFERRABLE INITIALLY DEFERRED,
  deleted_at_utc INTEGER,
  origin_device_id TEXT NOT NULL REFERENCES devices(id) DEFERRABLE INITIALLY DEFERRED,
  hlc TEXT NOT NULL,
  rev INTEGER NOT NULL DEFAULT 1,

  document_id TEXT NOT NULL REFERENCES documents(id) DEFERRABLE INITIALLY DEFERRED,
  line_no INTEGER NOT NULL CHECK (line_no >= 1),

  item_id TEXT REFERENCES items(id) DEFERRABLE INITIALLY DEFERRED,
  -- Snapshots again. An item renamed or repriced next month does not rewrite
  -- history, and a deleted item does not blank out an old invoice.
  item_name_snapshot TEXT NOT NULL,
  item_code_snapshot TEXT,
  hs_code_snapshot TEXT,
  description TEXT,

  -- What the cashier typed, in the unit they typed it in.
  qty_thousandths INTEGER NOT NULL CHECK (qty_thousandths <> 0),
  unit_id TEXT REFERENCES units(id) DEFERRABLE INITIALLY DEFERRED,
  unit_code_snapshot TEXT NOT NULL,
  -- The same quantity in the item's base unit. Stock moves on this.
  base_qty_thousandths INTEGER NOT NULL,

  -- Milli-paisa per the unit above.
  rate_milli_paisa INTEGER NOT NULL,
  mrp_paisa INTEGER,
  lot_id TEXT REFERENCES stock_lots(id) DEFERRABLE INITIALLY DEFERRED,

  gross_paisa INTEGER NOT NULL DEFAULT 0,
  -- Basis points, so 100% is 10000. Nothing else is a discount: a line
  -- discount over the line is a refund, and a negative one is a surcharge
  -- pretending otherwise.
  discount_bp INTEGER NOT NULL DEFAULT 0
    CHECK (discount_bp BETWEEN 0 AND 10000),
  discount_paisa INTEGER NOT NULL DEFAULT 0,
  taxable_paisa INTEGER NOT NULL DEFAULT 0,
  tax_paisa INTEGER NOT NULL DEFAULT 0,
  line_total_paisa INTEGER NOT NULL DEFAULT 0,
  -- Cost of goods on this line, captured at post time from the weighted
  -- average. Bill-wise profit reads this, never a recomputation against
  -- today's cost.
  cost_paisa INTEGER NOT NULL DEFAULT 0,

  is_free_item INTEGER NOT NULL DEFAULT 0 CHECK (is_free_item IN (0, 1))
) STRICT;

CREATE UNIQUE INDEX idx_doclines_seq ON document_lines (document_id, line_no);
CREATE INDEX idx_doclines_item ON document_lines (item_id, created_at_utc);
CREATE INDEX idx_doclines_firm_item ON document_lines (firm_id, item_id);
CREATE INDEX idx_doclines_unit ON document_lines (unit_id);
CREATE INDEX idx_doclines_lot ON document_lines (lot_id);

-- One row per tax that applied to one line. A single line can carry sales tax,
-- further tax and a provincial services tax at once, each with its own base —
-- which is why this cannot be three columns on the line.
CREATE TABLE document_line_taxes (
  id TEXT NOT NULL PRIMARY KEY,
  firm_id TEXT NOT NULL REFERENCES firms(id) DEFERRABLE INITIALLY DEFERRED,
  created_at_utc INTEGER NOT NULL,
  updated_at_utc INTEGER NOT NULL,
  created_by TEXT NOT NULL REFERENCES users(id) DEFERRABLE INITIALLY DEFERRED,
  updated_by TEXT NOT NULL REFERENCES users(id) DEFERRABLE INITIALLY DEFERRED,
  deleted_at_utc INTEGER,
  origin_device_id TEXT NOT NULL REFERENCES devices(id) DEFERRABLE INITIALLY DEFERRED,
  hlc TEXT NOT NULL,
  rev INTEGER NOT NULL DEFAULT 1,

  document_line_id TEXT NOT NULL REFERENCES document_lines(id) DEFERRABLE INITIALLY DEFERRED,
  -- Denormalised so the tax registers aggregate without a second join.
  document_id TEXT NOT NULL REFERENCES documents(id) DEFERRABLE INITIALLY DEFERRED,
  tax_rule_id TEXT REFERENCES tax_rules(id) DEFERRABLE INITIALLY DEFERRED,

  tax_kind TEXT NOT NULL CHECK (tax_kind IN (
    'sales_tax', 'further_tax', 'extra_tax', 'withholding',
    'provincial_st', 'fed', 'cess')),
  tax_code TEXT NOT NULL,
  -- Basis points. 18% is 1800, further tax 4% is 400, and the 8th Schedule's
  -- 8.5% and 12.75% stay exact integers rather than becoming 0.085.
  rate_bp INTEGER NOT NULL,
  base_paisa INTEGER NOT NULL,
  amount_paisa INTEGER NOT NULL,
  is_inclusive INTEGER NOT NULL DEFAULT 0 CHECK (is_inclusive IN (0, 1)),

  sro_schedule_no TEXT,
  sro_item_no TEXT
) STRICT;

CREATE INDEX idx_linetax_line ON document_line_taxes (document_line_id);
CREATE INDEX idx_linetax_doc ON document_line_taxes (document_id);
CREATE INDEX idx_linetax_register
  ON document_line_taxes (firm_id, tax_kind, created_at_utc);
CREATE INDEX idx_linetax_rule ON document_line_taxes (tax_rule_id);

-- The conversion chain: estimate to challan to invoice to return, and the
-- revision and reversal links. One tap converts; nothing is ever re-keyed.
CREATE TABLE doc_links (
  id TEXT NOT NULL PRIMARY KEY,
  firm_id TEXT NOT NULL REFERENCES firms(id) DEFERRABLE INITIALLY DEFERRED,
  created_at_utc INTEGER NOT NULL,
  updated_at_utc INTEGER NOT NULL,
  created_by TEXT NOT NULL REFERENCES users(id) DEFERRABLE INITIALLY DEFERRED,
  updated_by TEXT NOT NULL REFERENCES users(id) DEFERRABLE INITIALLY DEFERRED,
  deleted_at_utc INTEGER,
  origin_device_id TEXT NOT NULL REFERENCES devices(id) DEFERRABLE INITIALLY DEFERRED,
  hlc TEXT NOT NULL,
  rev INTEGER NOT NULL DEFAULT 1,

  from_document_id TEXT NOT NULL REFERENCES documents(id) DEFERRABLE INITIALLY DEFERRED,
  to_document_id TEXT NOT NULL REFERENCES documents(id) DEFERRABLE INITIALLY DEFERRED,
  link_type TEXT NOT NULL CHECK (link_type IN (
    'converted_from', 'returns', 'revises', 'reverses', 'fulfils')),
  -- Partial conversion: how much of the source this link consumed.
  qty_thousandths INTEGER,
  amount_paisa INTEGER,

  CHECK (from_document_id <> to_document_id)
) STRICT;

CREATE UNIQUE INDEX idx_doclinks_pair
  ON doc_links (from_document_id, to_document_id, link_type);
CREATE INDEX idx_doclinks_to ON doc_links (to_document_id);
CREATE INDEX idx_doclinks_firm ON doc_links (firm_id, link_type);
