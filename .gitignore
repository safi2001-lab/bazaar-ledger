# SQLite & Backup files
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.pkbak
*.db
*.db-wal
*.db-shm

# Melos workspace: leaf packages resolve through the workspace, so their
# lockfiles are noise. The app's lockfile at the root is committed.
packages/*/pubspec.lock

# Scratch probe tests written by audit agents while verifying a finding.
# They are throwaway by construction and must never reach the suite.
zz_*_test.dart

# Build-time identifiers: OAuth client ID, Play Billing public key.
# None are secrets — an Android OAuth client has no secret and the Billing
# key is public — but they belong to whoever owns the Play listing, and this
# repository may outlive that. The committed example documents every key.
config/app_config.json
